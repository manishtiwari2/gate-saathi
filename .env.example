# Copy to .env and fill in (the Prisma CLI reads .env, not .env.local).
# Never commit real secrets. Production values go in Netlify (docs/DEPLOY.md).
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# Database: Postgres. Locally, `docker compose up -d` starts one matching these
# (both the same). In production, from Supabase → Connect:
#   DATABASE_URL = transaction pooler, port 6543, ending ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = session pooler, port 5432 (used by migrations and the seed)
DATABASE_URL="postgresql://gate:gate@localhost:5432/gate_saathi"
DIRECT_URL="postgresql://gate:gate@localhost:5432/gate_saathi"

# Supabase (optional locally). Project Settings → API Keys.
# Project URL + publishable key (sb_publishable_...): Google and GitHub sign-in
# through Supabase Auth. Public by design; the tables are protected by
# row-level security.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Secret key (sb_secret_...): user uploads in Supabase Storage.
# SERVER ONLY: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="user-files"

# Anthropic API for the AI doubt engine (optional). Without it, the doubts page
# shows a "coming soon" card.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Razorpay payments for the one-time Premium pass (optional; TEST MODE keys only
# until we go live). Dashboard → Account & Settings → API Keys.
# Without the key id and secret, /pricing shows "Payments are coming soon".
# The key secret and webhook secret are SERVER ONLY: never prefix with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret you set when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=""
# Price of the Premium pass in paise (4900 = Rs 49). The server decides the
# amount; the browser never sends it. Leave empty to use 4900.
PREMIUM_PRICE_PAISE=""

# Shared store for rate limits and library presence (optional locally,
# required in production). Without it these use process memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Uploads go to Supabase Storage when the secret key is set; otherwise
# to local disk in development only. "false" turns them off, "true" forces disk.
ENABLE_UPLOADS=""

# Enable the dev login (any email, no password) for local work.
# Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN="true"
