# Copy to .env and fill in (the Prisma CLI reads .env, not .env.local).
# Never commit real secrets. Production values go in Vercel (docs/DEPLOY.md).

# Database: Postgres. Locally, `docker compose up -d` starts one matching these.
# In production (Neon) DATABASE_URL is the pooled URL and DIRECT_URL the direct
# one; locally they are the same.
DATABASE_URL="postgresql://gate:gate@localhost:5432/gate_saathi"
DIRECT_URL="postgresql://gate:gate@localhost:5432/gate_saathi"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Google OAuth (optional locally, required in production for sign-in).
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic API for the AI doubt engine (optional). Without it, the doubts page
# shows a "coming soon" card.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Shared store for rate limits and library presence (optional locally,
# recommended on Vercel). Without it these use process memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# User file uploads need a persistent disk: on by default, off on Vercel.
# Set "true"/"false" to override.
ENABLE_UPLOADS=""

# Enable the dev credentials login (any email, no password) for local work.
# Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN="true"
