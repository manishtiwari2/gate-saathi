# Copy to .env and fill in (the Prisma CLI reads .env, not .env.local).
# Never commit real secrets.

# Database. SQLite by default (zero setup). For Postgres, change the Prisma
# datasource provider to "postgresql" and set a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Google OAuth (optional). Without these, a dev credentials login is available.
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic API for the AI doubt engine (optional). Without it, the doubts page
# shows a "coming soon" card.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Enable the dev credentials login (any email, no password) for local work.
# Ignored when NODE_ENV=production.
ENABLE_DEV_LOGIN="false"
