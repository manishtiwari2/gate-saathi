// GATE Saathi data model. Postgres everywhere: Docker locally
// (docker-compose.yml), Supabase in production (docs/DEPLOY.md).
// Every table has row-level security on with no policies, so Supabase's
// public Data API can't read it; Prisma connects as the owner and isn't
// affected. Enable RLS in the migration of any new table.

generator client {
  provider      = "prisma-client-js"
  // "native" for this machine and Render; rhel for Netlify's Lambda functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase transaction pooler in production
  directUrl = env("DIRECT_URL") // session pooler / direct: migrations and the seed
}

// ---- Auth / users ----

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  displayName    String
  username       String?  @unique
  avatarUrl      String?
  dailyGoalMin   Int      @default(120)
  timezone       String   @default("Asia/Kolkata") // IANA zone; "today" and streaks use it
  role           String   @default("student")
  plan           String   @default("free") // free | premium
  createdAt      DateTime @default(now())

  studySessions  StudySession[]
  roomsOwned     Room[]         @relation("RoomOwner")
  memberships    RoomMember[]
  messages       RoomMessage[]
  files          UserFile[]
  attempts       QuestionAttempt[]
  paperAttempts  PaperAttempt[]
  doubts         DoubtQuery[]
  payments       Payment[]
}

model DoubtQuery {
  id         String   @id @default(cuid())
  userId     String
  question   String
  branch     String?
  subject    String?
  answer     String
  model      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Razorpay payments for the one-time Premium pass. Amounts are in paise.
// Restrict (not Cascade): a payment record must never vanish with its user.
model Payment {
  id          String    @id @default(cuid())
  userId      String
  provider    String    @default("razorpay")
  orderId     String    @unique
  paymentId   String?   @unique // set once Razorpay reports the payment
  amountPaise Int
  currency    String    @default("INR")
  status      String    @default("created") // created | paid | failed
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

// ---- PYQ bank ----

model Branch {
  code          String    @id // cs, ec, ...
  name          String
  displayName   String
  icon          String    @default("")
  questionCount Int       @default(0)
  yearMin       Int?
  yearMax       Int?
  subjects      Subject[]
  questions     Question[]
}

model Subject {
  id           String   @id @default(cuid())
  branchCode   String
  name         String
  displayName  String
  displayOrder Int      @default(0)
  branch       Branch   @relation(fields: [branchCode], references: [code])
  topics       Topic[]
  questions    Question[]

  @@unique([branchCode, name])
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  questions Question[]

  @@unique([subjectId, name])
}

model Question {
  id              String   @id @default(cuid())
  sourceId        String?  @unique // original questionId, e.g. gate-cs-2024-5
  branchCode      String
  subjectId       String?
  topicId         String?
  subjectName     String
  topicName       String?
  year            Int?
  session         String?
  questionNumber  String?
  questionType    String   @default("MCQ") // MCQ | MSQ | NAT
  marks           Int      @default(1)
  negativeMarks   Float    @default(0)
  difficulty      String   @default("medium")
  questionText    String
  questionHtml    String?
  options         String   @default("[]") // JSON array
  correctAnswer   String?  // seeded from collect-answers, may be null
  answerVerified  Boolean  @default(false)

  branch    Branch   @relation(fields: [branchCode], references: [code])
  subject   Subject? @relation(fields: [subjectId], references: [id])
  topic     Topic?   @relation(fields: [topicId], references: [id])
  attempts  QuestionAttempt[]
}

model QuestionAttempt {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ---- Mock papers ----

model Paper {
  id          String @id // CS-M1
  branchCode  String
  title       String
  description String?
  totalQuestions Int  @default(0)
  totalMarks     Int  @default(0)
  meta        String @default("{}") // JSON: difficulty split + subject breakdown
}

// ---- Official GATE papers (owner-supplied PDFs + official answer keys) ----

model OfficialPaper {
  id         String  @id // cs-2016-1
  branchCode String
  year       Int
  setLabel   String? // "Set 1", "Session 2", "Code A"
  institute  String? // organising institute, as printed
  note       String?
  pdfPath    String // served from /public
  pages      Int
  numbering  String  @default("sections") // sections: GA 1-10 + CS 1-55; continuous: CS 1-55 + GA 56-65
  keyStatus  String  @default("none") // official | none
  source     String
  questions  OfficialQuestion[]
  attempts   PaperAttempt[]

  @@index([branchCode, year])
}

// One row per question of a paper that has an official key. The key is never
// sent to the browser before the student answers.
model OfficialQuestion {
  id      String        @id @default(cuid())
  paperId String
  section String // GA | CS
  number  Int
  type    String // MCQ | MSQ | NAT
  key     String // "B", "A;C", "0.24 to 0.27 OR 0.3 to 0.3", or "MTA" (marks to all)
  marks   Int
  paper   OfficialPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, section, number])
}

model PaperAttempt {
  id          String        @id @default(cuid())
  userId      String
  paperId     String
  mode        String // practice | mock
  answers     String        @default("{}") // JSON: { "CS-12": "B", ... }
  score       Float
  maxScore    Float
  correct     Int
  wrong       Int
  unanswered  Int
  durationSec Int?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper       OfficialPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---- Cutoffs ----

model Cutoff {
  id              String @id @default(cuid())
  year            Int
  branchCode      String
  branchName      String
  generalCutoff   Float?
  obcCutoff       Float?
  scCutoff        Float?
  stCutoff        Float?
  totalApplicants Int?
  totalQualified  Int?
  qualifyingRate  Float?
  maxMarks        Int?

  @@unique([year, branchCode])
}

// ---- Study / rooms ----

model StudySession {
  id            String   @id @default(cuid())
  userId        String
  roomId        String?
  subject       String?
  seconds       Int      @default(0)
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id          String       @id @default(cuid())
  name        String
  description String?
  roomKey     String       @unique
  ownerId     String
  isPrivate   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  owner       User         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     RoomMember[]
  messages    RoomMessage[]
  files       RoomFile[]
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())
  presence String   @default("active") // active | break | away
  lastSeenAt DateTime @default(now()) // heartbeat from an open room page
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoomFile {
  id        String   @id @default(cuid())
  roomId    String
  fileId    String
  sharedAt  DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  file      UserFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model UserFile {
  id               String     @id @default(cuid())
  userId           String
  name             String
  originalFilename String
  mimeType         String
  fileSize         Int        @default(0)
  storagePath      String
  visibility       String     @default("private") // private | published
  accessTier       String     @default("free")
  branch           String?
  createdAt        DateTime   @default(now())
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomFiles        RoomFile[]
}
